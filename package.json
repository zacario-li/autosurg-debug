{
  "name": "autosurg-debug",
  "displayName": "AutoSurg Debug",
  "description": "Configure, control, and debug AutoSurg modules from VS Code.",
  "version": "0.2.12",
  "publisher": "autosurg",
  "icon": "media/icon.png",
  "author": {
    "name": "Zacario Li",
    "email": "zacario.li@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zacario-li/autosurg-debug.git"
  },
  "homepage": "https://github.com/zacario-li/autosurg-debug#readme",
  "bugs": {
    "url": "https://github.com/zacario-li/autosurg-debug/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "media",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onView:autosurg.modules",
    "onLanguage:yaml",
    "onDebug",
    "onCommand:autosurg.visualizeTensor"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap",
    "check": "tsc -p ./ --noEmit"
  },
  "contributes": {
    "commands": [
      {
        "command": "autosurg.refresh",
        "title": "AutoSurg: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "autosurg.validate",
        "title": "AutoSurg: Validate Configuration",
        "icon": "$(check)"
      },
      {
        "command": "autosurg.debug",
        "title": "AutoSurg: Debug Module",
        "icon": "$(debug-alt)"
      },
      {
        "command": "autosurg.debugAllComputes",
        "title": "AutoSurg: Debug All Compute Modules",
        "icon": "$(server-process)"
      },
      {
        "command": "autosurg.debugFullSystem",
        "title": "AutoSurg: Debug Full System",
        "icon": "$(debug-all)"
      },
      {
        "command": "autosurg.start",
        "title": "AutoSurg: Start Module"
      },
      {
        "command": "autosurg.stop",
        "title": "AutoSurg: Stop Module"
      },
      {
        "command": "autosurg.restart",
        "title": "AutoSurg: Restart Module"
      },
      {
        "command": "autosurg.visualizeTensor",
        "title": "View as Image / Tensor",
        "category": "AutoSurg",
        "icon": "$(file-media)"
      }
    ],
    "keybindings": [
      {
        "command": "autosurg.visualizeTensor",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "inDebugMode && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autosurg",
          "title": "AutoSurg",
          "icon": "media/autosurg.svg"
        }
      ]
    },
    "views": {
      "autosurg": [
        {
          "id": "autosurg.modules",
          "name": "Modules"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "autosurg.refresh",
          "when": "view == autosurg.modules",
          "group": "navigation@4"
        },
        {
          "command": "autosurg.validate",
          "when": "view == autosurg.modules",
          "group": "navigation@3"
        },
        {
          "command": "autosurg.debugAllComputes",
          "when": "view == autosurg.modules",
          "group": "navigation@2"
        },
        {
          "command": "autosurg.debugFullSystem",
          "when": "view == autosurg.modules",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "autosurg.debug",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(compute|orchestrator)/",
          "group": "inline"
        },
        {
          "command": "autosurg.start",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@1"
        },
        {
          "command": "autosurg.stop",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@2"
        },
        {
          "command": "autosurg.restart",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@3"
        }
      ],
      "debug/variables/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode",
          "group": "3_visualize"
        }
      ],
      "debug/watch/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode",
          "group": "3_visualize"
        }
      ],
      "editor/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode && editorHasSelection && editorLangId == python",
          "group": "3_visualize"
        }
      ]
    },
    "configuration": {
      "title": "AutoSurg",
      "properties": {
        "autosurg.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to modules.yaml, relative to the workspace root when not absolute."
        },
        "autosurg.controlHost": {
          "type": "string",
          "default": "localhost",
          "description": "ControlPlane host."
        },
        "autosurg.controlPython": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used for the ControlPlane client."
        },
        "autosurg.debugPortBase": {
          "type": "number",
          "default": 5678,
          "minimum": 1024,
          "maximum": 65535,
          "description": "First port considered for temporary compute debugging."
        },
        "autosurg.tensorHover": {
          "type": "boolean",
          "default": true,
          "description": "Show a tensor/image thumbnail when hovering a Python variable while the debugger is paused."
        }
      }
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
