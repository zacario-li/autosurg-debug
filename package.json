{
  "name": "autosurg-debug",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.25",
  "publisher": "autosurg",
  "icon": "media/icon.png",
  "author": {
    "name": "Zacario Li",
    "email": "zacario.li@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zacario-li/autosurg-debug.git"
  },
  "homepage": "https://github.com/zacario-li/autosurg-debug#readme",
  "bugs": {
    "url": "https://github.com/zacario-li/autosurg-debug/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "media",
    "resources",
    "LICENSE",
    "README.md",
    "README.zh-cn.md",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "docs/**"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onView:autosurg.modules",
    "onLanguage:yaml",
    "onStartupFinished",
    "onCommand:autosurg.visualizeTensor",
    "onCommand:autosurg.viewPly",
    "onCommand:autosurg.attachDiagnostics"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap && esbuild media/tensorView.src.js --bundle --format=iife --outfile=media/tensorView.js --minify",
    "check": "tsc -p ./ --noEmit",
    "test:attach": "esbuild test/attachHarness.ts --bundle --platform=node --outfile=.test/attachHarness.cjs --format=cjs && node .test/attachHarness.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "autosurg.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "autosurg.attachDiagnostics",
        "title": "%command.attachDiagnostics%",
        "icon": "$(report)"
      },
      {
        "command": "autosurg.validate",
        "title": "%command.validate%",
        "icon": "$(check)"
      },
      {
        "command": "autosurg.debug",
        "title": "%command.debug%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "autosurg.debugHot",
        "title": "%command.debugHot%",
        "icon": {
          "light": "media/debug-hot.svg",
          "dark": "media/debug-hot.svg"
        }
      },
      {
        "command": "autosurg.debugRestart",
        "title": "%command.debugRestart%",
        "icon": {
          "light": "media/debug-restart.svg",
          "dark": "media/debug-restart.svg"
        }
      },
      {
        "command": "autosurg.debugAllComputes",
        "title": "%command.debugAllComputes%",
        "icon": "$(server-process)"
      },
      {
        "command": "autosurg.debugFullSystem",
        "title": "%command.debugFullSystem%",
        "icon": "$(debug-all)"
      },
      {
        "command": "autosurg.start",
        "title": "%command.start%"
      },
      {
        "command": "autosurg.stop",
        "title": "%command.stop%"
      },
      {
        "command": "autosurg.restart",
        "title": "%command.restart%"
      },
      {
        "command": "autosurg.visualizeTensor",
        "title": "%command.visualizeTensor%",
        "category": "AutoSurg",
        "icon": "$(file-media)"
      },
      {
        "command": "autosurg.viewPly",
        "title": "%command.viewPly%"
      },
      {
        "command": "autosurg.viewCloud",
        "title": "%command.viewCloud%",
        "category": "AutoSurg"
      },
      {
        "command": "autosurg.openLogs",
        "title": "%command.openLogs%",
        "category": "AutoSurg"
      },
      {
        "command": "autosurg.monitor",
        "title": "%command.monitor%",
        "category": "AutoSurg",
        "icon": "$(dashboard)"
      },
      {
        "command": "autosurg.watch",
        "title": "%command.watch%",
        "category": "AutoSurg"
      }
    ],
    "keybindings": [
      {
        "command": "autosurg.visualizeTensor",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "inDebugMode && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autosurg",
          "title": "%viewContainers.autosurg%",
          "icon": "media/autosurg.svg"
        }
      ]
    },
    "views": {
      "autosurg": [
        {
          "id": "autosurg.modules",
          "name": "%views.modules%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "autosurg.attachDiagnostics",
          "when": "view == autosurg.modules",
          "group": "navigation@6"
        },
        {
          "command": "autosurg.monitor",
          "when": "view == autosurg.modules",
          "group": "navigation@1"
        },
        {
          "command": "autosurg.openLogs",
          "when": "view == autosurg.modules",
          "group": "navigation@5"
        },
        {
          "command": "autosurg.refresh",
          "when": "view == autosurg.modules",
          "group": "navigation@4"
        },
        {
          "command": "autosurg.validate",
          "when": "view == autosurg.modules",
          "group": "navigation@3"
        },
        {
          "command": "autosurg.debugAllComputes",
          "when": "view == autosurg.modules",
          "group": "navigation@2"
        },
        {
          "command": "autosurg.debugFullSystem",
          "when": "view == autosurg.modules",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "autosurg.debugHot",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(compute|orchestrator)/",
          "group": "inline@1"
        },
        {
          "command": "autosurg.debugRestart",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.compute/",
          "group": "inline@2"
        },
        {
          "command": "autosurg.debug",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.orchestrator/",
          "group": "inline"
        },
        {
          "command": "autosurg.debugHot",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(compute|orchestrator)/",
          "group": "autosurgDebug@1"
        },
        {
          "command": "autosurg.debugRestart",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.compute/",
          "group": "autosurgDebug@2"
        },
        {
          "command": "autosurg.debug",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.orchestrator/",
          "group": "autosurgDebug@1"
        },
        {
          "command": "autosurg.start",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@1"
        },
        {
          "command": "autosurg.stop",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@2"
        },
        {
          "command": "autosurg.restart",
          "when": "view == autosurg.modules && viewItem =~ /autosurg\\.(module|compute|orchestrator)\\.ok/",
          "group": "autosurg@3"
        }
      ],
      "debug/variables/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode",
          "group": "3_visualize"
        },
        {
          "command": "autosurg.viewCloud",
          "when": "inDebugMode",
          "group": "3_visualize"
        }
      ],
      "debug/watch/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode",
          "group": "3_visualize"
        },
        {
          "command": "autosurg.viewCloud",
          "when": "inDebugMode",
          "group": "3_visualize"
        }
      ],
      "editor/context": [
        {
          "command": "autosurg.visualizeTensor",
          "when": "inDebugMode && editorHasSelection && editorLangId == python",
          "group": "3_visualize"
        },
        {
          "command": "autosurg.viewCloud",
          "when": "inDebugMode && editorHasSelection && editorLangId == python",
          "group": "3_visualize"
        }
      ],
      "explorer/context": [
        {
          "command": "autosurg.viewPly",
          "when": "resourceExtname == .ply",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "autosurg.configPath": {
          "type": "string",
          "default": "",
          "description": "%config.configPath%"
        },
        "autosurg.controlHost": {
          "type": "string",
          "default": "localhost",
          "description": "%config.controlHost%"
        },
        "autosurg.controlPython": {
          "type": "string",
          "default": "python3",
          "description": "%config.controlPython%"
        },
        "autosurg.webuiPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "%config.webuiPort%"
        },
        "autosurg.logView": {
          "type": "string",
          "enum": [
            "terminal",
            "output",
            "both"
          ],
          "default": "terminal",
          "description": "%config.logView%",
          "enumDescriptions": [
            "%config.logView.terminal%",
            "%config.logView.output%",
            "%config.logView.both%"
          ]
        },
        "autosurg.debugPortBase": {
          "type": "number",
          "default": 5678,
          "minimum": 1024,
          "maximum": 65535,
          "description": "%config.debugPortBase%"
        },
        "autosurg.tensorHover": {
          "type": "boolean",
          "default": true,
          "description": "%config.tensorHover%"
        },
        "autosurg.diagnosticsFolder": {
          "type": "string",
          "default": "",
          "description": "%config.diagnosticsFolder%"
        }
      }
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "three": "^0.185.1",
    "typescript": "^7.0.2"
  }
}
